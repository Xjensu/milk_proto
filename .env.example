RACK_ENV=development
HANAMI_ENV=development

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=database_development
POSTGRES_USER=xjensu
POSTGRES_PASSWORD=changeme123

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MINIO_REGION=ap-southeast-2

DATABASE_URL=postgresql://xjensu:changeme123@db:5432/database_development
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=uploads

REDIS_PASSWORD=securepass
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# Observability
ACCESS_LOG_PATH=log/access.json
ACCESS_LOG_QUEUE_SIZE=4096
# Optional links shown to super administrators in the Rails admin panel.
# Keep these as absolute HTTP(S) URLs; invalid values are ignored by the UI.
OBSERVABILITY_GRAFANA_URL=http://localhost:3001
OBSERVABILITY_PROMETHEUS_URL=http://localhost:9090
OBSERVABILITY_LOKI_URL=http://localhost:3100

# Scheduling: lab group-split rule (labs with students_now > threshold split into 2 sub-groups)
LAB_SPLIT_THRESHOLD=18
LAB_ACTIVITY_CODE=LAB
WHOIS_ENABLED=true
WHOIS_CACHE_TTL=3600
TRUSTED_PROXIES=

# Phase 2 — media upload pipeline
MEDIA_QUARANTINE_BUCKET=media-quarantine
MEDIA_CLEAN_BUCKET=media-clean
MEDIA_MAX_FILE_SIZE=52428800
GHOSTSCRIPT_BIN=gs
EXIFTOOL_BIN=exiftool

# ---------------------------------------------------------------------------
# schedule_web — public Rails 8 + Hotwire frontend (port 3000)
# ---------------------------------------------------------------------------
# Names only, no values. Real values belong in .env.local, which compose feeds
# to the container via env_file.

# Required. Rails refuses to boot in production without it.
SECRET_KEY_BASE=

# Upstream API and the admin SPA the footer links out to.
API_GETEWAY_URL=http://api_geteway:2300
ADMIN_PANEL_URL=http://localhost:4173

# Falcon worker processes (one fiber reactor each).
WEB_CONCURRENCY=2

# Outbound HTTP budget, in seconds. timeout_total bounds the whole attempt
# including retries; connect/read bound the phases.
UPSTREAM_TIMEOUT_CONNECT=1.0
UPSTREAM_TIMEOUT_READ=3.0
UPSTREAM_TIMEOUT_TOTAL=5.0

# Circuit breaker: open after THRESHOLD consecutive failures inside WINDOW
# seconds, then reject fast for COOLDOWN seconds. Breaker state is kept in
# Redis, not process memory, so all Falcon workers share one view.
BREAKER_THRESHOLD=5
BREAKER_WINDOW=30
BREAKER_COOLDOWN=15

# Stale-while-error cache. Within FRESH_TTL a copy is served without touching
# the network; between FRESH_TTL and STALE_TTL it is served only when the
# upstream call fails, with the age shown in the UI.
CACHE_FRESH_TTL=60
CACHE_STALE_TTL=86400

# Rack::Attack budgets, requests per minute per IP. LOGIN guards POST /session.
RATE_LIMIT_GENERAL=300
RATE_LIMIT_LOGIN=10

REDIS_POOL_SIZE=16

# TLS. Both default false so direct HTTP against port 3000 keeps working (the
# Docker healthcheck hits /up over plain HTTP). Set both true only once a
# TLS-terminating proxy actually sits in front: ASSUME_SSL marks session
# cookies `secure`, and browsers silently drop secure cookies over plain HTTP,
# which breaks sign-in with no visible error.
ASSUME_SSL=false
FORCE_SSL=false
