# Runtime settings: copy to .env.local, or run deploy/bin/init-env.py once.
# Blank secrets are intentional. Never replace an existing file during upgrades.
# Use hex passwords for new installations; URL credentials must be URL-encoded.

# Docker Hub release selection and server controls. No host IP entry needed.
COMPOSE_PROJECT_NAME=milk_schedule
IMAGE_NAMESPACE=xjensu
IMAGE_TAG=2026-10-06-1
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80
WEB_REPLICAS=2
ADMIN_INTERFACE=
ADMIN_LAN_CIDRS=
NOTICE_EXPORT_PUBLIC_ENDPOINT=

# PostgreSQL: these values initialize a NEW volume only.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=milk_schedule
POSTGRES_USER=milk_schedule
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis. Discovery replaces the internal address at runtime.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_POOL_SIZE=16

# MinIO: client and server credentials must agree.
MINIO_ACCESS_KEY=milk_schedule
MINIO_SECRET_KEY=
MINIO_ROOT_USER=${MINIO_ACCESS_KEY}
MINIO_ROOT_PASSWORD=${MINIO_SECRET_KEY}
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=ap-southeast-2
MINIO_BUCKET=uploads
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=uploads
MEDIA_QUARANTINE_BUCKET=media-quarantine
MEDIA_CLEAN_BUCKET=media-clean
NOTICE_EXPORT_BUCKET=milk-schedule-notices

# Signing keys and bootstrap administrator (separate from the /ops account).
JWT_SECRET=
SECRET_KEY_BASE=
SEED_ADMIN_EMAIL=admin@milk-schedule.local
SEED_ADMIN_PASSWORD=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Browser origin used on this server, without a trailing slash.
CORS_ORIGINS=http://localhost

# Fallback for direct startup; Compose enables Consul discovery.
API_GETEWAY_URL=http://api_geteway:2300
WEB_CONCURRENCY=1
UPSTREAM_TIMEOUT_CONNECT=1.0
UPSTREAM_TIMEOUT_READ=3.0
UPSTREAM_TIMEOUT_TOTAL=5.0
BREAKER_THRESHOLD=5
BREAKER_WINDOW=30
BREAKER_COOLDOWN=15
CACHE_FRESH_TTL=60
CACHE_STALE_TTL=86400
RATE_LIMIT_GENERAL=300
RATE_LIMIT_LOGIN=10

# HTTP is the current ingress protocol. TLS also requires proxy configuration.
ASSUME_SSL=false
FORCE_SSL=false

# Application tuning.
LAB_SPLIT_THRESHOLD=18
LAB_ACTIVITY_CODE=LAB
WHOIS_ENABLED=true
WHOIS_CACHE_TTL=3600
MEDIA_MAX_FILE_SIZE=52428800
GHOSTSCRIPT_BIN=gs
EXIFTOOL_BIN=exiftool
ACCESS_LOG_PATH=log/access.json
ACCESS_LOG_QUEUE_SIZE=4096

# Optional browser-facing monitoring links; empty unless configured.
OBSERVABILITY_GRAFANA_URL=
OBSERVABILITY_PROMETHEUS_URL=
OBSERVABILITY_LOKI_URL=
