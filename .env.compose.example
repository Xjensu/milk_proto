# Compose/release settings. Copy to .env; never copy another host's generated/.
# Keep the project name stable: it determines persistent volume names.
COMPOSE_PROJECT_NAME=milk_schedule
IMAGE_NAMESPACE=xjensu
IMAGE_TAG=2026-10-05-1

# Blank selects a single private LAN interface/address automatically.
# Explicit selection also supports a VPN or a public server IPv4 address.
ADMIN_INTERFACE=
LAN_BIND_IP=
# Trusted administrator client CIDRs, comma-separated, e.g. 192.168.10.0/24.
# Required with a public server address. Never use 0.0.0.0/0.
ADMIN_LAN_CIDRS=

# The existing ingress serves HTTP. TLS requires separate proxy configuration.
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80
WEB_REPLICAS=2
# Optional browser-reachable object URL; default: http://LAN_BIND_IP:9000.
NOTICE_EXPORT_PUBLIC_ENDPOINT=

# Infrastructure versions are independent of the application release tag.
POSTGRES_IMAGE=pgrouting/pgrouting:15-3.5-develop
REDIS_IMAGE=redis:7-alpine
# Pinned to the digest already used by this installation, not a floating latest.
MINIO_IMAGE=quay.io/minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
CONSUL_IMAGE=hashicorp/consul:1.22.7
